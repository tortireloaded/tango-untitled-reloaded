---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatBubble from '../components/ChatBubble.astro';
import { buildLink, SITE_NAME_FULL, STUDIO_ADDRESS, CONTACT_EMAIL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Active nav key — sets aria-current */
  current?: string;
  /** Open Graph image (absolute URL or site-relative) */
  ogImage?: string;
  /** JSON-LD type for this page */
  jsonLdType?: 'home' | 'class' | 'team' | 'location' | 'practica' | 'article';
  /** Class name list for teacher/skill — used for Course schema */
  jsonLdData?: Record<string, any>;
}

const { title, description, current, ogImage, jsonLdType, jsonLdData } = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://www.tangountitled.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title === SITE_NAME_FULL ? title : `${title} · Tango Untitled`;
const ogImageAbs = ogImage ? new URL(ogImage, siteUrl).toString() : new URL('/og-default.jpg', siteUrl).toString();

// JSON-LD structured data — per page type
const jsonLd: Record<string, any> = (() => {
  if (jsonLdType === 'home') {
    return {
      '@context': 'https://schema.org',
      '@type': ['DanceSchool', 'LocalBusiness'],
      name: SITE_NAME_FULL,
      alternateName: 'Tango Untitled · 無題探戈',
      url: siteUrl,
      description,
      email: CONTACT_EMAIL,
      image: ogImageAbs,
      address: {
        '@type': 'PostalAddress',
        streetAddress: "18/F, 361 Queen's Road Central, Nan Dao Commercial Building",
        addressLocality: 'Sheung Wan',
        addressRegion: 'Hong Kong',
        addressCountry: 'HK',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 22.2855,
        longitude: 114.1522,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday', 'Sunday'],
          timeOfDay: ['12:00', '18:00'],
        },
      ],
      sameAs: [
        'https://instagram.com/tango.untitled',
        'http://facebook.com/tango.untitled',
        'https://www.youtube.com/@tango.untitled',
      ],
    };
  }
  if (jsonLdType === 'class' && jsonLdData) {
    return {
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: jsonLdData.name,
      description: jsonLdData.description,
      provider: { '@type': 'Organization', name: SITE_NAME_FULL, sameAs: siteUrl },
      offers: jsonLdData.price ? {
        '@type': 'Offer',
        price: jsonLdData.price,
        priceCurrency: 'HKD',
      } : undefined,
      inLanguage: ['en', 'zh-Hant'],
    };
  }
  if (jsonLdType === 'team' && jsonLdData) {
    return {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: jsonLdData.name,
      jobTitle: 'Argentine Tango Teacher & Performer',
      worksFor: { '@type': 'Organization', name: SITE_NAME_FULL },
      sameAs: jsonLdData.sameAs,
    };
  }
  if (jsonLdType === 'location') {
    return {
      '@context': 'https://schema.org',
      '@type': 'Place',
      name: 'Tango Untitled Studio',
      address: {
        '@type': 'PostalAddress',
        streetAddress: "18/F, 361 Queen's Road Central, Nan Dao Commercial Building",
        addressLocality: 'Sheung Wan',
        addressRegion: 'Hong Kong',
        addressCountry: 'HK',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 22.2855, longitude: 114.1522 },
    };
  }
  return null;
})();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#0e0e10" />
  <meta name="color-scheme" content="light" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/svg+xml" href={buildLink('/favicon.svg')} />
  <link rel="alternate icon" href={buildLink('/favicon.ico')} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME_FULL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:locale" content="en_HK" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <link rel="preconnect" href="https://images.squarespace-cdn.com" crossorigin />
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <Header current={current} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <ChatBubble />
</body>
</html>
