---
import { buildLink, SITE_NAME_EN, SITE_NAME_ZH, CONTACT_EMAIL, SITE_TAGLINE } from '../lib/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="brand-block">
        <div class="brand-mark">
          <span class="en">{SITE_NAME_EN}</span>
          <span class="zh">{SITE_NAME_ZH}</span>
        </div>
        <p class="motto">{SITE_TAGLINE} · Class · Practica · Workshop · Performance</p>
      </div>

      <nav aria-label="Footer">
        <h3>Explore</h3>
        <ul>
          <li><a href={buildLink('/')}>Home</a></li>
          <li><a href={buildLink('/about-us/')}>About</a></li>
          <li><a href={buildLink('/classes/')}>Classes</a></li>
          <li><a href={buildLink('/practica/')}>Practica</a></li>
          <li><a href={buildLink('/location/')}>Location</a></li>
          <li><a href={buildLink('/book/')}>Book a Class</a></li>
        </ul>
      </nav>

      <div class="contact">
        <h3>Reach us</h3>
        <ul>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li class="address">18/F, 361 Queen's Road Central<br />Nan Dao Commercial Building<br />Sheung Wan, Hong Kong</li>
        </ul>
      </div>

      <div class="socials">
        <h3>Follow</h3>
        <ul class="social-list">
          <li><a href="https://instagram.com/tango.untitled" aria-label="Instagram" rel="me">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
            <span>Instagram</span>
          </a></li>
          <li><a href="http://facebook.com/tango.untitled" aria-label="Facebook" rel="me">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            <span>Facebook</span>
          </a></li>
          <li><a href="https://www.youtube.com/@tango.untitled" aria-label="YouTube" rel="me">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.04C5.12 19.5 12 19.5 12 19.5s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
            <span>YouTube</span>
          </a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <p>© 2023–2026 {SITE_NAME_EN} · {SITE_NAME_ZH}</p>
      <p>TANGO UNTITLED LIMITED · Hong Kong</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-9);
    padding-block: var(--s-7) var(--s-5);
    background: var(--ink);
    color: rgba(250,250,247,.85);
    font-size: .92rem;
  }
  .site-footer h4 {
    font-family: var(--sans);
    font-size: .8rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: rgba(250,250,247,.55);
    margin-bottom: var(--s-4);
    font-weight: 600;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: var(--s-6);
    margin-bottom: var(--s-7);
  }
  .brand-mark {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    margin-bottom: var(--s-3);
  }
  .brand-mark .en {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--paper);
  }
  .brand-mark .zh {
    font-family: var(--serif);
    font-size: .85rem;
    letter-spacing: .35em;
    color: rgba(250,250,247,.55);
  }
  .motto { color: rgba(250,250,247,.7); }
  .site-footer a { color: rgba(250,250,247,.85); text-decoration-color: rgba(250,250,247,.2); }
  .site-footer a:hover { color: var(--paper); text-decoration-color: var(--paper); }
  .site-footer ul { list-style: none; padding: 0; }
  .site-footer li + li { margin-top: var(--s-2); }
  .address { font-style: normal; line-height: 1.55; color: rgba(250,250,247,.65); }
  .social-list li a {
    display: inline-flex; align-items: center; gap: .6rem;
  }
  .footer-base {
    border-top: 1px solid rgba(250,250,247,.12);
    padding-top: var(--s-5);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-3);
    color: rgba(250,250,247,.55);
    font-size: .82rem;
  }
  .footer-base p { margin: 0; color: inherit; }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
